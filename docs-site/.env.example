# Shared password entered on the faucet page.
ZKAPI_FAUCET_PASSWORD=replace-with-a-long-random-password

# Dedicated Sepolia-only wallet that pays gas for mint transactions.
ZKAPI_FAUCET_PRIVATE_KEY=0xreplace-with-a-64-character-private-key

# Optional. When omitted, viem's default Sepolia RPC is used.
ZKAPI_SEPOLIA_RPC_URL=https://your-sepolia-rpc.example
