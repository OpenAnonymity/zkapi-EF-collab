{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "./scripts/package-browser-client-mainnet.sh",
  "outputDirectory": "dist/browser-mainnet",
  "rewrites": [
    {
      "source": "/zkapi-deployment/:path*",
      "destination": "https://d27v1dvkaxfc09.cloudfront.net/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/funding/",
      "permanent": false
    },
    {
      "source": "/funding",
      "destination": "/funding/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/funding/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
